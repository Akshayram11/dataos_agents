# Copy to fct_daily_sales-soda-rules.yml and change name/depends_on if your Vulcan allows a second
# suite — otherwise run these checks from postgres-productise/dq/fct_daily_sales.yml (rules section).
#
# NOT loadable together with fct_daily_sales-dq.yml on the same model (one DQ file per depends_on).
kind: dq
name: fct_daily_sales_soda_dq
depends_on: s3lhdepotrr.silver_sparkv.fct_daily_sales

profiles:
  - order_date
  - region_name
  - category

rules:
  - failed rows:
      name: shipment_rate_matches_counts
      dimension: accuracy
      fail query: |
        SELECT order_date, region_id, customer_id, product_id, total_orders, total_shipments, shipment_rate
        FROM silver_sparkv.fct_daily_sales
        WHERE total_orders > 0
          AND ABS(
            shipment_rate - ROUND(
              CAST(total_shipments AS DECIMAL(18, 4)) / NULLIF(CAST(total_orders AS DECIMAL(18, 4)), 0),
              4
            )
          ) > 0.0001
      samples limit: 20
      description: Shipment rate should match shipped orders divided by total orders at the daily grain

  - failed rows:
      name: all_regions_are_covered
      dimension: coverage
      fail query: |
        SELECT 'missing_region_coverage' AS issue_type
        WHERE (SELECT COUNT(DISTINCT region_name) FROM silver_sparkv.fct_daily_sales) < 5
      samples limit: 20
      description: Daily sales should cover all five business regions

  - failed rows:
      name: generated_sales_window_is_current
      dimension: timeliness
      fail query: |
        SELECT 'stale_generated_sales_window' AS issue_type
        WHERE (SELECT MAX(CAST(order_date AS DATE)) FROM silver_sparkv.fct_daily_sales) < DATE '2020-01-01'
      samples limit: 20
      description: Generated daily sales should include data in the expected current analytical window
